<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_700"
    android:orientation="vertical"
    tools:context=".view.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">


        <ImageButton
            android:id="@+id/btnBackScreenPortion"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:backgroundTint="@color/green_700"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            app:srcCompat="@drawable/back_button_icon" />

        <TextView
            android:id="@+id/txtTitleMain"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ADICIONAR PARCELA"
            android:textColor="@color/white"
            android:textFontWeight="700"
            android:textSize="24dp" />

        <ImageView
            android:id="@+id/imgIconParcelaView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/fence_icon" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/shape_container_itens"
        android:layout_marginTop="25dp"
        >


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="560dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <EditText
                android:id="@+id/inputNamePortion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="18dp"
                android:background="@drawable/button_layout"
                android:backgroundTint="@color/light_green"
                android:ems="10"
                android:hint="@string/name_portion_input"
                android:inputType="text"
                android:paddingLeft="20dp"
                android:textColorHint="@color/green_dark" />

            <EditText
                android:id="@+id/inputFormFactorPortion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="15dp"
                android:layout_marginRight="18dp"
                android:background="@drawable/button_layout"
                android:backgroundTint="@color/light_green"
                android:ems="10"
                android:hint="@string/fator_de_forma"
                android:inputType="text"
                android:paddingLeft="20dp"
                android:textColorHint="@color/green_dark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="vertical">


            <Button
                android:id="@+id/btnSavePortion"
                android:layout_width="260dp"
                android:layout_height="45dp"
                android:background="@drawable/button_layout"
                android:backgroundTint="@color/brown_700"
                android:drawableLeft="@drawable/save_icon"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingLeft="70dp"
                android:paddingBottom="20px"
                android:text="@string/name_button_save_portion"
                android:textColor="@color/light_brown"
                android:textFontWeight="500"
                android:textSize="18dp" />
        </LinearLayout>


    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    </androidx.recyclerview.widget.RecyclerView>


</LinearLayout>

