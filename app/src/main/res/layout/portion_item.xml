<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_box_itens_information"
    android:layout_marginBottom="10dp"
    android:paddingBottom="15dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/containerImagePortion"
        android:layout_width="70dp"
        android:layout_height="60dp"
        app:cardBackgroundColor="@color/brown_700"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:paddingRight="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        >

 <ImageView
     android:id="@+id/iconItemList"
     android:layout_width="60dp"
     android:layout_height="60dp"
     android:src="@drawable/portion_icon"
     android:layout_gravity="center"
     android:scaleType="fitCenter"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/portionNameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PORTION NAME"
        android:textSize="20sp"
        android:textFontWeight="900"
        android:maxLength="15"
        android:textColor="@color/white"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintStart_toEndOf="@+id/containerImagePortion"
        app:layout_constraintTop_toTopOf="parent"
        />


    <TextView
        android:id="@+id/qtyTextItens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qtd:"
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintStart_toEndOf="@+id/containerImagePortion"
        app:layout_constraintTop_toBottomOf="@+id/portionNameView"
        />

    <TextView
        android:id="@+id/qtyNumberItens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50 Mudas"
        android:textSize="12dp"
        android:layout_marginLeft="5dp"
        android:textColor="@color/brown_text"
        android:layout_marginTop="5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintStart_toEndOf="@+id/qtyTextItens"
        app:layout_constraintTop_toBottomOf="@+id/portionNameView"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/contentIconNextPage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="20dp"
        app:cardBackgroundColor="#D46B5C"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/next_page_icon" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>